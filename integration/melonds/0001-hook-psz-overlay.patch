@@ -1168,6 +1172,46 @@ void ScreenPanelGL::drawScreen()
             glDrawArrays(GL_TRIANGLES, screenKind[i] == 0 ? 0 : 2 * 3, 2 * 3);
         }
 
+        // psz-melonmix: the overlay. This is the only display path this build
+        // has -- see MainWindow::createScreenPanel -- so it is the only place
+        // the HUD is drawn.
+        for (int i = 0; i < numScreens; i++)
+        {
+            if (screenKind[i] != 0) continue;   // top screen only
+
+            // screenMatrix is the affine the screen shader uses. Mind the
+            // layout: it is uploaded with glUniformMatrix2x3fv(..., GL_TRUE)
+            // into a GLSL mat2x3 (2 COLUMNS, 3 rows) and applied as
+            // vec3(pos,1) * M, so column 0 is (m0,m2,m4) and column 1 is
+            // (m1,m3,m5) -- the components interleave rather than splitting into
+            // two halves. Reading it as [m0,m1,m2] / [m3,m4,m5] puts the quads
+            // somewhere off screen and the overlay silently does not appear.
+            //   out.x = m0*x + m2*y + m4 ,  out.y = m1*x + m3*y + m5
+            // Take all four corners so a rotated layout still gives a sane box.
+            const float* m = screenMatrix[i];
+            float xs[4], ys[4];
+            const float cx[4] = {0.f, 256.f, 0.f, 256.f};
+            const float cy[4] = {0.f, 0.f, 192.f, 192.f};
+            for (int k = 0; k < 4; k++)
+            {
+                xs[k] = m[0]*cx[k] + m[2]*cy[k] + m[4];
+                ys[k] = m[1]*cx[k] + m[3]*cy[k] + m[5];
+            }
+            float x0 = xs[0], x1 = xs[0], y0 = ys[0], y1 = ys[0];
+            for (int k = 1; k < 4; k++)
+            {
+                if (xs[k] < x0) x0 = xs[k];
+                if (xs[k] > x1) x1 = xs[k];
+                if (ys[k] < y0) y0 = ys[k];
+                if (ys[k] > y1) y1 = ys[k];
+            }
+
+            PSZMix::Frame psz = PSZMix::Update(nds);
+            const float topRect[4] = {x0, y0, x1 - x0, y1 - y0};
+            pszOverlay.draw(psz, w / factor, h / factor, topRect);
+            break;
+        }
+
         screenSettingsLock.unlock();
     }
 

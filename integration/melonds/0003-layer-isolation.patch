 GPU2D::GPU2D(u32 num, melonDS::GPU& gpu) : Num(num), GPU(gpu)
 {
+    // PSZ: engine-B (and A) 2D layer isolation for HUD compositing R&D.
+    if (const char* m = std::getenv(num == 0 ? "PSZ_LAYER_MASK_A" : "PSZ_LAYER_MASK_B"))
+        DebugLayerMask = (u32)strtoul(m, nullptr, 0);
 }
 
 void GPU2D::Reset()

+    {"Instance*.Window*.ScreenSizing", 4},
+    {"Instance*.Window*.ScreenAspectTop", 1},
     {"Screen.VSyncInterval", 1},
-    {"3D.Renderer", renderer3D_Software},
+    // OpenGL rather than upstream's software default. Window.cpp picks the
+    // display path from this -- hasOGL = Screen.UseGL || 3D.Renderer != software
+    // -- so the renderer setting decides which of the two PSZ overlays runs.
+    // The GL one is the path this build is developed and tested on; the QPainter
+    // one stays as the fallback for a machine where the context fails to create.
+    {"3D.Renderer", renderer3D_OpenGL},
     {"3D.GL.ScaleFactor", 1},
 #ifdef JIT_ENABLED
     {"JIT.MaxBlockSize", 32},

     override fun dispatchGenericMotionEvent(event: MotionEvent): Boolean {
+        // psz-melonmix: right stick steers the camera. The DS has no right
+        // stick, so nothing downstream consumes these axes -- reading them here
+        // costs nothing and does not disturb melonDS's own axis mapping, which
+        // runs after and can still claim the event.
+        //
+        // AXIS_Z is right-X on the standard Android gamepad layout; RX is the
+        // fallback some pads report instead. Deadzone kills the resting drift
+        // that would otherwise rotate the camera forever.
+        if (event.source and InputDevice.SOURCE_CLASS_JOYSTICK == InputDevice.SOURCE_CLASS_JOYSTICK) {
+            var rx = event.getAxisValue(MotionEvent.AXIS_Z)
+            if (kotlin.math.abs(rx) < 0.02f) rx = event.getAxisValue(MotionEvent.AXIS_RX)
+            MelonEmulator.pszSetCameraStick(if (kotlin.math.abs(rx) < 0.15f) 0f else rx)
+
+            // Left stick, raw. melonDS maps it onto d-pad bits, which is where
+            // the direction resolution is lost; the plugin uses the true vector
+            // to correct the heading afterwards.
+            // The left stick DOES arrive as AXIS_X/Y -- an earlier reading of
+            // zero came from a stale APK, not from the device. The hat fallback
+            // and the axis probe that established this are removed.
+            val lx = event.getAxisValue(MotionEvent.AXIS_X)
+            val ly = event.getAxisValue(MotionEvent.AXIS_Y)
+            MelonEmulator.pszSetMoveStick(lx, ly)
+        }
+
         if (!activeOverlays.hasActiveOverlays() && nativeInputListener.onMotionEvent(event))
             return true
 

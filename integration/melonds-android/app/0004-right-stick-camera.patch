+
+extern "C" JNIEXPORT void JNICALL
+Java_me_magnum_melonds_MelonEmulator_pszSetCameraStick(JNIEnv* env, jobject thiz, jfloat x)
+{
+    // Right-stick camera control. The DS has no right stick, so this is input
+    // the emulated machine never had -- the plugin turns it into a write of the
+    // game's own camera target yaw.
+    // Logged so a dead stick can be told apart from a dead native call: if this
+    // never appears, the axis is not reaching Kotlin; if it appears and the
+    // camera still does not move, the problem is downstream.
+    // Diagnostic only on request: unconditional logging spams logcat in a
+    // shipped build, and it has already served its purpose.
+    if (getenv("PSZ_CAM_DEBUG"))
+    {
+        static int n = 0;
+        if ((n++ % 30) == 0)
+            __android_log_print(4, "psz-melonmix", "JNI stick=%.3f", (double) x);
+    }
+    PSZMix::SetCameraStick((float) x);
+}

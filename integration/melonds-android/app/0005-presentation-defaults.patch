+    /**
+     * Put this build's cheat database into the cheat menu, once, on first run.
+     *
+     * melonDS ships with an empty cheat list and expects you to find a database
+     * on the web and import it through Settings. On a handheld that is a real
+     * errand, and it is the same database every time for a build that plays one
+     * game -- so it comes bundled and lands in the menu by itself.
+     *
+     * ALL OF THEM ARRIVE DISABLED. The parser constructs every cheat with
+     * enabled = false and nothing here changes that: these are stat maxers,
+     * experience multipliers and movement codes, which are taste rather than
+     * improvement. The one cheat that IS simply on -- 16:9 widescreen -- is
+     * applied by the plugin instead and is deliberately absent from the
+     * database, because a switch that does not turn it off is worse than none.
+     *
+     * Guarded by a preference rather than by looking for the database: a user
+     * who deletes it meant to, and re-seeding on the next launch would make it
+     * impossible to get rid of.
+     *
+     * THE GUARD STORES THE ASSET'S OWN HASH, not a version number somebody has
+     * to remember to bump. The first cut used a "_v1" key and a changed XML
+     * shipped without touching it, which left an already-seeded device unable to
+     * ever see the new cheats -- silently, because the guard did exactly what it
+     * was told. Keying on the content makes editing the XML the same act as
+     * invalidating the guard.
+     */
+    @OptIn(DelicateCoroutinesApi::class)
+    private fun seedBundledCheats() {
+        val prefs = PreferenceManager.getDefaultSharedPreferences(this)
+
+        GlobalScope.launch(Dispatchers.IO) {
+            try {
+                val bytes = assets.open(BUNDLED_CHEATS_ASSET).use { it.readBytes() }
+                val hash = bytes.contentHashCode().toString()
+                if (prefs.getString(PREF_CHEATS_SEEDED, null) == hash) return@launch
+
+                bytes.inputStream().use { stream ->
+                    XmlCheatDatabaseParser().parseCheatDatabase(
+                        ProgressTrackerInputStream(stream),
+                        object : CheatDatabaseParserListener {
+                            override fun onDatabaseParseStart(databaseName: String): CheatDatabase = runBlocking {
+                                cheatsRepository.deleteCheatDatabaseIfExists(databaseName)
+                                cheatsRepository.addCheatDatabase(databaseName)
+                            }
+
+                            override fun onGameParseStart(gameName: String) = Unit
+
+                            override fun onGameParsed(game: Game): Unit = runBlocking {
+                                cheatsRepository.addGameCheats(game)
+                            }
+
+                            override fun onParseComplete() = Unit
+                        },
+                    )
+                }
+                prefs.edit().putString(PREF_CHEATS_SEEDED, hash).apply()
+            } catch (e: Exception) {
+                // Seeding is a convenience. A failure here must not stop the app
+                // starting, and leaving the flag unset lets the next launch retry.
+            }
+        }
+    }
+

# Assembled upstream trees — scripts/bootstrap.sh recreates them at pinned revs
build/

# Copyrighted game data — never commit.
# Savestates are the sharp edge: a melonDS savestate is a full dump of DS main
# RAM, so it carries the game's own code and data.
*.nds
*.sav
*.ml[0-9]
*.mln
runs/*.ml*
roms/
bios/
firmware/
sandbox*/

dist/
.DS_Store

# psz/art/ IS tracked. kion's call: a few PNGs is fair use, and keeping them
# out was incidental -- he was avoiding committing anything under assets/, not
# holding these back. scripts/fetch-hud-art.sh still refreshes them.
